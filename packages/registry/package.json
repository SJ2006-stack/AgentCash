{
  "name": "@agentcash/registry",
  "version": "0.1.0",
  "description": "AgentCash x402 API registry — curated listings, capability lookup, price probes",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
