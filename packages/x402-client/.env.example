# AgentCash CLI environment (copy to packages/x402-client/.env — never commit .env)

# Deployment: switches registry/API base URLs (facilitator URL separate)
# dev | staging | prod
AGENTCASH_ENV=prod

# Telemetry (optional PostHog stub — no events unless key is set)
# AGENTCASH_POSTHOG_KEY=
# AGENTCASH_NO_TELEMETRY=1

# --- Wallet (BYOK default) ---
# Local wallet is created at ~/.agentcash/wallet.key (chmod 600) via:
#   agentcash wallet create
# Optional override (CI/scripts):
# EVM_PRIVATE_KEY=

# Optional: force Coinbase CDP server wallet instead of local file
# X402_WALLET_MODE=cdp-server
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# CDP_WALLET_NAME=agentcash

# --- Network ---
# Default CLI network is Base mainnet. Use --testnet for Base Sepolia.
# Or set explicitly:
# X402_NETWORK=base-mainnet
# X402_NETWORK=base-sepolia

# Optional custom RPC (defaults: public Base endpoints)
# RPC_URL=https://mainnet.base.org
# ALCHEMY_KEY=your-alchemy-key

# --- Facilitator (Coinbase x402 for Base USDC) ---
# cdp (default) | x402org
X402_FACILITATOR=cdp
# Override facilitator URL entirely:
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# --- Pay CLI ---
# X402_DEMO_URL=https://weather.hugen.tokyo/weather/current
# MIN_USDC_BALANCE=0.01

# --- Stubs (not in v0) ---
# WALLET_CONNECT_PROJECT_ID=
# SVM_PRIVATE_KEY=
