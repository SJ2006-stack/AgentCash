{
  "name": "agentcash-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/json-schema": "7.0.15"
  },
  "scripts": {
    "build": "npm run build:cf",
    "build:cf": "npm run build:cf -w web",
    "dev:web": "npm run dev -w web",
    "deploy:cf": "npm run build:cf && cd apps/web && npx wrangler deploy"
  },
  "devDependencies": {
    "shadcn": "^4.7.0"
  }
}
